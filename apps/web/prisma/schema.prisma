// YAIGC database schema v0
//
// Phase 1 scope: Auth.js v5 standard tables + minimal User extensions.
// Business tables (Family, FamilyMember, Recipient, Companion, Visit,
// AuditLogEntry) land in subsequent migrations as each context is built.
//
// Conventions:
// - `id` is cuid() everywhere (URL-friendly, sortable, no leaked counts)
// - Every business model has createdAt / updatedAt
// - Models holding personal data have deletedAt for soft-delete with audit
// - Migrations are append-only — never edit a committed migration

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Auth.js v5 standard tables (Prisma adapter)
// ----------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?

  // YAIGC business fields
  firstName String?
  lastName  String?
  role      UserRole @default(family_payer)

  // Password (optional, P.1). argon2id hash. NULL means the user is
  // magic-link only - they can set a password from /account/security.
  // passwordSetAt also acts as the "last changed" marker because we
  // never store a separate "last changed" column.
  passwordHash  String?
  passwordSetAt DateTime?

  // Audit
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  accounts                Account[]
  sessions                Session[]
  familyMembers           FamilyMember[]
  companion               Companion?
  proposedMatches         Match[]                @relation("MatchProposedBy")
  endedMatches            Match[]                @relation("MatchEndedBy")
  submittedReports        PostVisitReport[]      @relation("ReportSubmittedBy")
  openedCases             SafeguardingCase[]     @relation("CaseOpenedBy")
  closedCases             SafeguardingCase[]     @relation("CaseClosedBy")
  assignedCases           SafeguardingCase[]     @relation("CaseAssignedTo")
  caseNotes               SafeguardingCaseNote[]
  rightToWorkVerified     CompanionApplication[] @relation("RightToWorkVerifiedBy")
  badgesAwarded           CompanionBadge[]       @relation("BadgeAwardedBy")

  @@index([email])
  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@index([expires])
}

// ----------------------------------------------------------------------------
// Family context (SDD §12.2) — the buying side of the marketplace.
//
// One Family is a single customer relationship. It holds:
//   - one or more FamilyMembers (the payer plus optionally household members)
//   - one or more Recipients (the older adults receiving visits)
//   - subscriptions, payments, etc. (added in later stages)
//
// Address fields are intentionally flattened here rather than modelled as
// embedded composite types: simpler to query, simpler to migrate. JSON or
// Postgres composite types can come later if we need richer modelling.
//
// Sensitive PII fields (address, dateOfBirth, healthNotes, mobility,
// religiousObservance) carry an `isSensitive: true` access-control intent
// that the application layer should respect when surfacing data to
// non-operator-admin roles. The fields are not currently gated at the DB
// layer; that is operator_safeguarding / operator_admin RBAC work for a
// later stage.
// ----------------------------------------------------------------------------

model Family {
  id                 String        @id @default(cuid())
  status             FamilyStatus  @default(prospect)
  billingName        String
  intakeNotes        String?       @db.Text

  // Billing address (SDD §12.2.1 "billingAddress (embedded type) — for
  // invoicing, distinct from recipient address"). Flattened columns
  // rather than a composite type for query simplicity.
  billingAddressLine1 String?
  billingAddressLine2 String?
  billingCity         String?
  billingPostcode     String?
  billingCountry      String  @default("GB")

  joinedAt           DateTime      @default(now())
  cancelledAt        DateTime?
  cancellationReason String?       @db.Text

  members       FamilyMember[]
  recipients    Recipient[]
  matches       Match[]
  subscriptions Subscription[]
  visits        Visit[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status, createdAt(sort: Desc)])
}

model FamilyMember {
  id                      String                     @id @default(cuid())
  familyId                String
  userId                  String
  role                    FamilyMemberRole           @default(payer)
  relationshipToRecipient FamilyMemberRelationship?
  isPrimaryContact        Boolean                    @default(false)
  addedAt                 DateTime                   @default(now())

  family Family @relation(fields: [familyId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([familyId, userId])
  @@index([familyId])
  @@index([userId])
}

model Recipient {
  id                  String    @id @default(cuid())
  familyId            String
  firstName           String
  lastName            String
  preferredName       String?
  dateOfBirth         DateTime? @db.Date
  phone               String?
  pronouns            String?
  interests           String?   @db.Text
  thingsToKnow        String?   @db.Text
  mobility            String?   @db.Text
  healthNotes         String?   @db.Text
  dietary             String?   @db.Text
  religiousObservance String?   @db.Text

  // Visit address (SDD §12.2.3 "address (embedded type) — Full address.
  // Visible only to assigned companion and operators."). Currently no
  // DB-level RBAC; the application layer is the gate.
  addressLine1   String?
  addressLine2   String?
  addressCity    String?
  addressPostcode String?
  addressCountry String  @default("GB")

  // Consents (SDD §12.2.3). Booleans are the queryable current state.
  // The audit log captures every flip with the operator who made it,
  // the timestamp, and an evidence note in metadata — that is the
  // GDPR-grade record, not these flags.
  consentToVisits        Boolean @default(false)
  consentToPhotos        Boolean @default(false)
  consentToReportSharing Boolean @default(true)

  family            Family             @relation(fields: [familyId], references: [id])
  matches           Match[]
  subscriptions     Subscription[]
  visits            Visit[]
  safeguardingCases SafeguardingCase[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([familyId])
}

enum FamilyStatus {
  prospect    // intake done, no first visit yet
  active      // visiting
  paused      // subscription paused
  cancelled   // subscription cancelled
  archived    // historical / removed from active lists
}

enum FamilyMemberRole {
  payer       // billing access; full account control
  viewer      // [Phase 2] read-only secondary household member
}

enum FamilyMemberRelationship {
  daughter
  son
  partner
  spouse
  sibling
  grandchild
  other
}

// ----------------------------------------------------------------------------
// Match (SDD §12.4.5) — the operator-proposed connection between a Family's
// Recipient and a Companion. Per DR-002, all matching is operator-led in v1
// (no self-serve algorithmic matching).
//
// Lifecycle:
//   proposed -> accepted (both sides confirmed via phone, captured by operator)
//             -> declined (with reason)
//             -> withdrawn (operator pulled before either side responded)
//
// Once accepted, the operator goes on to create a Subscription (Stage O.7.2)
// which generates the recurring Visits the family pays for.
// ----------------------------------------------------------------------------

model Match {
  id                   String      @id @default(cuid())
  familyId             String
  recipientId          String?     // null when the family has exactly one recipient
  candidateCompanionId String
  proposedByOperatorId String
  status               MatchStatus @default(proposed)
  rationale            String      @db.Text

  familyResponseAt        DateTime?
  companionResponseAt     DateTime?
  declineReason           String?   @db.Text
  // Action-reminder cron idempotency (single-shot nudges).
  familyReminderSentAt    DateTime?
  companionReminderSentAt DateTime?

  // Un-match (after acceptance). status=ended means a confirmed pairing
  // was separated. Distinct from declined/withdrawn which are
  // pre-acceptance outcomes. endReason drives both UI copy and any
  // downstream effects (safeguarding_concern auto-opens a case in O.7.5).
  endedAt           DateTime?
  endReason         MatchEndReason?
  endNote           String?        @db.Text
  endedByOperatorId String?

  family           Family            @relation(fields: [familyId], references: [id])
  recipient        Recipient?        @relation(fields: [recipientId], references: [id])
  companion        Companion         @relation(fields: [candidateCompanionId], references: [id])
  proposedBy       User              @relation("MatchProposedBy", fields: [proposedByOperatorId], references: [id])
  endedBy          User?             @relation("MatchEndedBy", fields: [endedByOperatorId], references: [id])
  subscription     Subscription?
  safeguardingCase SafeguardingCase?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([familyId, status])
  @@index([candidateCompanionId, status])
  @@index([status, createdAt(sort: Desc)])
}

enum MatchStatus {
  proposed
  accepted
  declined
  withdrawn
  ended
}

enum MatchEndReason {
  not_a_fit
  scheduling_conflict
  recipient_circumstances_changed
  recipient_passed_away
  companion_circumstances_changed
  safeguarding_concern
  other
}

// ----------------------------------------------------------------------------
// Subscription (SDD §12.4.1) — the recurring schedule a Family pays for. A
// single Subscription pins one Recipient to one Companion at a fixed day +
// time + duration + hourly rate. Stripe is not wired in v1 (DR-005 deferred);
// stripeSubscriptionId is nullable until the payments stage lands.
//
// Visits (Stage O.7.3) are generated from a Subscription's schedule. The
// Subscription itself is metadata - pause/cancel here ripples to which
// future visits get created.
// ----------------------------------------------------------------------------

model Subscription {
  id                   String                @id @default(cuid())
  familyId             String
  recipientId          String
  companionId          String
  originatingMatchId   String?               @unique
  status               SubscriptionStatus    @default(active)
  frequency            SubscriptionFrequency
  dayOfWeek            DayOfWeek
  startTime            String                // "HH:MM" 24h, local UK time
  durationMinutes      Int
  hourlyRate           Decimal               @db.Decimal(8, 2)
  stripeSubscriptionId String?               @unique
  startedAt            DateTime              @default(now())
  pauseStartAt         DateTime?
  pauseEndAt           DateTime?
  endedAt              DateTime?
  cancellationReason   String?               @db.Text
  notes                String?               @db.Text

  // Pause/cancel requests submitted by the family via /family/subscription.
  // The family does not change subscription state directly; they flag an
  // intent for operator review. Cleared by transitionSubscription when the
  // matching status transition lands. Both nullable; non-null = open request.
  pauseRequestedAt      DateTime?
  pauseRequestedReason  String?  @db.Text
  cancelRequestedAt     DateTime?
  cancelRequestedReason String?  @db.Text

  family           Family    @relation(fields: [familyId], references: [id])
  recipient        Recipient @relation(fields: [recipientId], references: [id])
  companion        Companion @relation(fields: [companionId], references: [id])
  originatingMatch Match?    @relation(fields: [originatingMatchId], references: [id])
  visits           Visit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([familyId, status])
  @@index([companionId, status])
  @@index([status, dayOfWeek])
}

// ----------------------------------------------------------------------------
// Visit (SDD §12.4.2) — a single companionship visit. Generated from a
// Subscription's recurring schedule. The state machine (SDD §11.1) is
// driven by the operator in v1 since neither the companion portal nor the
// family portal exists yet — the operator updates state based on phone
// calls from the companion.
//
// State flow:
//   scheduled -> confirmed -> en_route -> in_progress -> completed -> reported
//             \-> cancelled_by_family | cancelled_by_companion | cancelled_by_operator
//             \-> no_show_companion | no_show_recipient
//
// scheduledStartAt is stored as UTC, computed from the Subscription's
// dayOfWeek + startTime (HH:MM UK local) via a small Intl-based helper
// that handles BST/GMT correctly. actualStartAt / actualEndAt are
// captured when the operator moves the visit through in_progress and
// completed — those drive billing accuracy.
// ----------------------------------------------------------------------------

model Visit {
  id                       String     @id @default(cuid())
  subscriptionId           String
  familyId                 String
  recipientId              String
  companionId              String

  state                    VisitState @default(scheduled)
  scheduledStartAt         DateTime
  scheduledDurationMinutes Int
  actualStartAt            DateTime?
  actualEndAt              DateTime?

  agreedActivity           String?    @db.Text
  safetyFlags              String?    @db.Text

  cancellationReason       String?    @db.Text
  cancellationActor        CancellationActor?

  stateChangedAt              DateTime   @default(now())
  reminderSentAt              DateTime?  // 24h-before reminder; null until the cron fires
  confirmationReminderSentAt  DateTime?  // single-fire nudge for unconfirmed visits ~4h out
  reportReminderSentAt        DateTime?  // single-fire nudge for completed visits without a report

  subscription      Subscription       @relation(fields: [subscriptionId], references: [id])
  family            Family             @relation(fields: [familyId], references: [id])
  recipient         Recipient          @relation(fields: [recipientId], references: [id])
  companion         Companion          @relation(fields: [companionId], references: [id])
  report            PostVisitReport?
  safeguardingCases SafeguardingCase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([state, scheduledStartAt])
  @@index([subscriptionId, scheduledStartAt(sort: Desc)])
  @@index([companionId, scheduledStartAt])
  @@index([familyId, scheduledStartAt])
}

// ----------------------------------------------------------------------------
// PostVisitReport (SDD §12.4.3) — companion's report after each Visit. The
// family-facing summary is a redacted view: it includes what happened and
// wellbeing observations, but NOT thingsToFlag (operator-only). When the
// recipient has consentToReportSharing=false, the family email is skipped
// and the audit log captures that.
//
// In v1 the operator submits the report on behalf of the companion (from
// a phone call / text) since the companion portal is not built. The
// submittedByOperatorId column carries the operator's User id. When the
// companion portal lands (Phase 2) the same row will be written by the
// companion's session.
//
// PostVisitReportPhoto (SDD §12.4.4) is deferred to a follow-up stage.
// ----------------------------------------------------------------------------

model PostVisitReport {
  id                    String           @id @default(cuid())
  visitId               String           @unique
  companionId           String

  actualDurationMinutes Int
  whatHappened          String           @db.Text
  howWereThey           WellbeingRating
  howWereTheyNote       String?          @db.Text
  thingsToFlag          String?          @db.Text

  submittedAt           DateTime         @default(now())
  submittedByOperatorId String?
  deliveredToFamilyAt   DateTime?

  visit            Visit                  @relation(fields: [visitId], references: [id])
  companion        Companion              @relation(fields: [companionId], references: [id])
  submittedBy      User?                  @relation("ReportSubmittedBy", fields: [submittedByOperatorId], references: [id])
  photos           PostVisitReportPhoto[]
  safeguardingCase SafeguardingCase?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companionId, submittedAt(sort: Desc)])
  @@index([submittedAt(sort: Desc)])
}

// PostVisitReportPhoto (SDD §12.4.4) — photos that go alongside a
// post-visit report. Per-photo recipientConsentConfirmed is required by
// law (recipient must consent to images of themselves being shared).
// Files live on disk under /home/username/igc-platform/uploads/post-visit-reports/
// <reportId>/. The filename is server-generated; the original client
// filename is discarded.
model PostVisitReportPhoto {
  id                        String   @id @default(cuid())
  postVisitReportId         String
  filename                  String
  contentType               String
  sizeBytes                 Int
  recipientConsentConfirmed Boolean  @default(false)
  uploadedAt                DateTime @default(now())

  report PostVisitReport @relation(fields: [postVisitReportId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([postVisitReportId])
}

enum WellbeingRating {
  cheerful
  quiet
  tired
  unwell
  distressed
  other
}

// ----------------------------------------------------------------------------
// SafeguardingCase (SDD §12.6) — the operator-facing workflow for concerns
// flagged on the platform. Cases auto-open from two triggers:
//   1. PostVisitReport with non-empty thingsToFlag (severity defaults to
//      medium) - one case per report (relatedReportId @unique)
//   2. Match ended with reason=safeguarding_concern (severity defaults to
//      high) - one case per match (relatedMatchId @unique)
// Operators can also open cases manually.
//
// Case workflow: open -> under_review -> actioned -> closed. Closure
// requires both a category and a note. Assignment defaults to no-one;
// any operator can pick a case up.
//
// Notes (SafeguardingCaseNote) form a linear thread under the case. They
// are operator-only - never surfaced to the family or companion.
// ----------------------------------------------------------------------------

model SafeguardingCase {
  id                    String                       @id @default(cuid())
  status                SafeguardingStatus           @default(open)
  severity              SafeguardingSeverity         @default(medium)
  summary               String                       @db.Text

  subjectRecipientId    String?
  relatedVisitId        String?
  relatedReportId       String?                      @unique
  relatedMatchId        String?                      @unique

  openedAt              DateTime                     @default(now())
  openedByOperatorId    String?                      // null when system-opened
  assignedToOperatorId  String?
  closedAt              DateTime?
  closedByOperatorId    String?
  closureCategory       SafeguardingClosureCategory?
  closureNote           String?                      @db.Text

  subjectRecipient Recipient?             @relation(fields: [subjectRecipientId], references: [id])
  relatedVisit     Visit?                 @relation(fields: [relatedVisitId], references: [id])
  relatedReport    PostVisitReport?       @relation(fields: [relatedReportId], references: [id])
  relatedMatch     Match?                 @relation(fields: [relatedMatchId], references: [id])
  openedBy         User?                  @relation("CaseOpenedBy", fields: [openedByOperatorId], references: [id])
  closedBy         User?                  @relation("CaseClosedBy", fields: [closedByOperatorId], references: [id])
  assignedTo       User?                  @relation("CaseAssignedTo", fields: [assignedToOperatorId], references: [id])
  notes            SafeguardingCaseNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, openedAt(sort: Desc)])
  @@index([assignedToOperatorId, status])
  @@index([subjectRecipientId, openedAt(sort: Desc)])
  @@index([severity, status])
}

model SafeguardingCaseNote {
  id               String   @id @default(cuid())
  caseId           String
  authorOperatorId String?
  body             String   @db.Text
  createdAt        DateTime @default(now())

  case   SafeguardingCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  author User?            @relation(fields: [authorOperatorId], references: [id])

  @@index([caseId, createdAt])
}

enum SafeguardingStatus {
  open
  under_review
  actioned
  closed
}

enum SafeguardingSeverity {
  low
  medium
  high
  critical
}

enum SafeguardingClosureCategory {
  no_action_needed
  followed_up_with_family
  followed_up_with_companion
  companion_removed
  external_referral
  other
}

enum VisitState {
  scheduled
  confirmed
  en_route
  in_progress
  completed
  reported
  cancelled_by_family
  cancelled_by_companion
  cancelled_by_operator
  no_show_companion
  no_show_recipient
}

enum CancellationActor {
  family
  companion
  operator
}

enum SubscriptionStatus {
  active
  paused
  canceled
}

enum SubscriptionFrequency {
  weekly
  biweekly
  monthly
}

enum DayOfWeek {
  mon
  tue
  wed
  thu
  fri
  sat
  sun
}

// ----------------------------------------------------------------------------
// Companion context (SDD §12.3) — the supply side of the marketplace.
//
// CompanionApplication holds an inbound application from /companions/join
// and the operator pipeline (received -> in_triage -> phone_screen ->
// interview -> vetting -> complete | declined | withdrawn).
//
// Approval at status=complete creates the Companion row and links the
// application to it. Companion is the active record that the operator
// console, the booking engine, and (later) the companion portal consume.
//
// Deferred to later stages:
//   - CompanionReference (Stage O.6.1) — two referees per application
//   - TrainingModule + TrainingCompletion (Stage O.6.2)
//   - DBS encryption at rest (Stage O.6.2) — currently TEXT, app layer
//     gates access by operator role
//   - Stripe Connect onboarding (Stage O.7+)
//   - Availability calendar (Phase 2)
// ----------------------------------------------------------------------------

model CompanionApplication {
  id     String                     @id @default(cuid())
  status CompanionApplicationStatus @default(received)

  firstName String
  lastName  String
  email     String
  phone     String
  postcode  String

  availabilitySummary String @db.Text
  availabilitySlots   Json?
  whyJoinReason       String @db.Text
  aboutYou            String @db.Text

  rightToWork            Boolean // self-attestation by applicant
  backgroundCheckConsent Boolean

  // Right-to-work compliance (SDD §5.4). The applicant declares the
  // type of right they have (UK national, settled, visa, etc.) and
  // submits supporting evidence (passport scan, BRP, gov.uk share-code
  // PDF). The operator runs the share code at
  // gov.uk/view-right-to-work and captures the verification result
  // below. dateOfBirth is required for the share-code check.
  dateOfBirth                     DateTime?       @db.Date
  rightToWorkType                 RightToWorkType?
  rightToWorkShareCode            String?
  rightToWorkExpiresAt            DateTime?       @db.Date
  rightToWorkVerifiedAt           DateTime?
  rightToWorkVerifiedByOperatorId String?
  rightToWorkVerificationNote     String?         @db.Text

  // Operator pipeline metadata
  triageNotes          String? @db.Text
  declineReason        String? @db.Text
  assignedToOperatorId String?

  companion         Companion?
  rightToWorkVerifiedBy User?               @relation("RightToWorkVerifiedBy", fields: [rightToWorkVerifiedByOperatorId], references: [id])
  documents         CompanionDocument[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status, createdAt(sort: Desc)])
  @@index([email])
  @@index([rightToWorkVerifiedAt])
}

// CompanionDocument — uploaded evidence for right-to-work, DBS, and
// other compliance artefacts. Lives on the application so a single FK
// covers both pre-approval (file uploaded at intake) and post-approval
// (Companion uploads a replacement after expiry). Files are stored in
// S3 under companion-documents/<applicationId>/<filename>; bucket is
// private and the /api/companion-documents/[id] route auth-gates each
// fetch to operator + the owning companion.
model CompanionDocument {
  id                  String                @id @default(cuid())
  companionApplicationId String
  kind                CompanionDocumentKind
  filename            String                // server-generated; original client filename discarded
  contentType         String
  sizeBytes           Int
  description         String?               @db.Text
  uploadedAt          DateTime              @default(now())
  uploadedByActorType ActorType
  uploadedByActorId   String?
  // Soft delete - operator-controlled. Audit trail rules out hard delete.
  archivedAt          DateTime?
  archivedByOperatorId String?
  archivedReason      String?               @db.Text

  application CompanionApplication @relation(fields: [companionApplicationId], references: [id], onDelete: Cascade)

  @@index([companionApplicationId, uploadedAt(sort: Desc)])
  @@index([kind, uploadedAt(sort: Desc)])
}

enum RightToWorkType {
  british_irish_passport
  settled_status
  pre_settled_status
  skilled_worker_visa
  graduate_visa
  student_visa
  dependant_visa
  indefinite_leave_to_remain
  other
}

enum CompanionDocumentKind {
  passport
  brp                  // Biometric Residence Permit
  share_code_pdf
  visa_letter
  ilr_document
  dbs_certificate
  driver_licence
  photo_id
  proof_of_address
  insurance_certificate
  other
}

model Companion {
  id            String              @id @default(cuid())
  userId        String              @unique
  applicationId String              @unique
  status        CompanionStatus     @default(onboarding)

  firstName     String  // public-facing
  lastName      String  // operator-only
  photoUrl      String?
  photoFilename String? // server-generated; objects live at s3://.../companion-profiles/<id>/<filename>
  bio           String? @db.Text
  borough       CompanionBorough
  interests     String? @db.Text

  availability         Json?
  maxConcurrentMatches Int  @default(4)

  // Compliance documents. dbsCertificateNumber stored as TEXT for now;
  // app-layer access gating only. DB-layer encryption is Stage O.6.2.
  dbsCertificateNumber String?
  dbsIssuedAt          DateTime? @db.Date
  dbsRenewalDueAt      DateTime? @db.Date
  insuranceProvider    String?
  insuranceExpiresAt   DateTime? @db.Date

  // Driver's licence. Optional - not every companion drives. Number is
  // a free text field; pattern varies by issuing country. The expiry
  // date feeds the compliance dashboard alongside DBS and insurance.
  driverLicenceNumber    String?
  driverLicenceExpiresAt DateTime? @db.Date

  // Full home address. The application captures postcode only; once
  // approved we keep a proper address on the Companion record. Used
  // for the pre-accept travel-time estimate, future routing, and the
  // operator-facing summary. PII - operator-only.
  addressLine1     String?
  addressLine2     String?
  addressCity      String?
  addressPostcode  String?
  addressCountry   String  @default("GB")

  // Optional preference - how far the companion is happy to travel
  // from home for a visit. Surfaced as a soft filter when proposing
  // matches; null means "no preference stated".
  maxTravelMiles   Int?

  // Payments. Stripe Connect onboarding is deferred to Stage O.7+.
  stripeConnectedAccountId String?
  engagementType           CompanionEngagementType @default(worker)
  hourlyRate               Decimal                 @default(12.00) @db.Decimal(10, 2)

  user          User                 @relation(fields: [userId], references: [id])
  application   CompanionApplication @relation(fields: [applicationId], references: [id])
  matches       Match[]
  subscriptions Subscription[]
  visits        Visit[]
  reports       PostVisitReport[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  badges        CompanionBadge[]

  @@index([status])
  @@index([borough, status])
  @@index([dbsRenewalDueAt])
}

// Internal-only descriptive labels operators attach to a companion -
// languages spoken, skills, contexts (dementia experience, drives,
// first-aid trained). Not visible to families. They eventually feed
// match scoring. Tiers based on visit count are NOT stored here -
// they are derived live from Visit history.
model CompanionBadge {
  id                  String   @id @default(cuid())
  companionId         String
  slug                String   // matches a key in lib/badges.ts catalogue
  awardedAt           DateTime @default(now())
  awardedByOperatorId String?

  companion   Companion @relation(fields: [companionId], references: [id], onDelete: Cascade)
  awardedBy   User?     @relation("BadgeAwardedBy", fields: [awardedByOperatorId], references: [id])

  @@unique([companionId, slug])
  @@index([slug])
}

enum CompanionApplicationStatus {
  received
  in_triage
  phone_screen
  interview
  vetting
  complete
  declined
  withdrawn
}

enum CompanionStatus {
  onboarding
  active
  suspended
  archived
}

enum CompanionBorough {
  south_manchester
  trafford
  stockport
  salford
}

enum CompanionEngagementType {
  self_employed
  worker
  employed
}

// ----------------------------------------------------------------------------
// Marketing context (SDD §12.10) — inbound enquiries from the public site.
// A new Enquiry is created by any of:
//   - the /contact form (source = contact_form)
//   - the /companions/join form (source = companion_application)
//   - a waitlist form for out-of-area visitors (source = waitlist) [Phase 2]
// The operator triages from /ops/enquiries. When an Enquiry becomes a paying
// customer, convertedToFamilyId is set and status moves to "converted".
// ----------------------------------------------------------------------------

model Enquiry {
  id                    String          @id @default(cuid())
  source                EnquirySource
  name                  String
  email                 String
  phone                 String?
  postcode              String?
  message               String          @db.Text
  status                EnquiryStatus   @default(new)
  assignedToOperatorId  String?
  consentMarketing      Boolean         @default(false)
  convertedToFamilyId   String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  // Soft foreign key — once a Family is created from this Enquiry, the
  // operator surface uses convertedToFamilyId to deep-link. No DB FK is
  // declared here because (a) we may want to allow merging two enquiries
  // into one Family later, and (b) cascading deletes between contexts
  // are deliberately avoided per the data conventions in SDD §12.1.

  @@index([status, createdAt(sort: Desc)])
  @@index([source, createdAt(sort: Desc)])
  @@index([email])
  @@index([convertedToFamilyId])
}

enum EnquirySource {
  contact_form
  waitlist
  companion_application
}

enum EnquiryStatus {
  new
  triaged
  converted
  closed
}

// ----------------------------------------------------------------------------
// Audit context (SDD §12.7) — append-only log of every sensitive action.
// Append-only is enforced at the DB layer by triggers; see migration
// 20260521..._add_audit_log_entry. Per DR-008, this lives in the same
// Postgres database as the rest of the app for v1 scale.
// ----------------------------------------------------------------------------

model AuditLogEntry {
  id          BigInt     @id @default(autoincrement())
  occurredAt  DateTime   @default(now())
  actorType   ActorType
  actorId     String?
  actorRole   String?
  actionType  ActionType
  targetType  String
  targetId    String?
  beforeState Json?
  afterState  Json?
  ip          String?
  userAgent   String?
  requestId   String?
  metadata    Json?

  @@index([occurredAt(sort: Desc)])
  @@index([actorId, occurredAt(sort: Desc)])
  @@index([targetType, targetId])
  @@index([actionType, occurredAt(sort: Desc)])
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------

// User roles per SDD §12.9.1. Lowercase snake_case to match the SDD spec
// exactly; Prisma generates idiomatic enum members on the TS side
// (`UserRole.family_payer`).
//
// Operator sub-roles enable least-privilege RBAC in the operator console
// (DR-013 spirit): a finance operator does not need access to safeguarding
// cases, a read_only operator cannot mutate, etc.
enum ActorType {
  user
  system
  integration
}

// Action categories per SDD §12.7.1. Granular enough to support meaningful
// log search ("show me every payment action by this operator last week")
// without exploding into one enum per concrete event type.
enum ActionType {
  create
  update
  delete
  read_sensitive   // operator opened a record containing PII
  state_change     // visit state machine, case state machine, etc.
  auth             // sign-in, sign-out, 2FA challenge
  payment          // any payment-context event
  consent          // recipient consent capture or revocation
  export           // data export by operator or by GDPR access request
}

enum UserRole {
  family_payer
  family_viewer            // [Phase 2] secondary household members
  companion
  operator_coordinator     // default operator role: bookings, matches, day-to-day ops
  operator_safeguarding    // safeguarding lead, case management
  operator_finance         // payment runs, invoicing, reconciliation
  operator_admin           // full access (you, Bassey)
  operator_read_only       // observer access (investor, auditor, advisor)
}
