// YAIGC database schema v0
//
// Phase 1 scope: Auth.js v5 standard tables + minimal User extensions.
// Business tables (Family, FamilyMember, Recipient, Companion, Visit,
// AuditLogEntry) land in subsequent migrations as each context is built.
//
// Conventions:
// - `id` is cuid() everywhere (URL-friendly, sortable, no leaked counts)
// - Every business model has createdAt / updatedAt
// - Models holding personal data have deletedAt for soft-delete with audit
// - Migrations are append-only — never edit a committed migration

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Auth.js v5 standard tables (Prisma adapter)
// ----------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?

  // YAIGC business fields
  firstName String?
  lastName  String?
  role      UserRole @default(family_payer)

  // Audit
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  accounts        Account[]
  sessions        Session[]
  familyMembers   FamilyMember[]

  @@index([email])
  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@index([expires])
}

// ----------------------------------------------------------------------------
// Family context (SDD §12.2) — the buying side of the marketplace.
//
// One Family is a single customer relationship. It holds:
//   - one or more FamilyMembers (the payer plus optionally household members)
//   - one or more Recipients (the older adults receiving visits)
//   - subscriptions, payments, etc. (added in later stages)
//
// Address fields are intentionally flattened here rather than modelled as
// embedded composite types: simpler to query, simpler to migrate. JSON or
// Postgres composite types can come later if we need richer modelling.
//
// Sensitive PII fields (address, dateOfBirth, healthNotes, mobility,
// religiousObservance) carry an `isSensitive: true` access-control intent
// that the application layer should respect when surfacing data to
// non-operator-admin roles. The fields are not currently gated at the DB
// layer; that is operator_safeguarding / operator_admin RBAC work for a
// later stage.
// ----------------------------------------------------------------------------

model Family {
  id                 String        @id @default(cuid())
  status             FamilyStatus  @default(prospect)
  billingName        String
  intakeNotes        String?       @db.Text

  joinedAt           DateTime      @default(now())
  cancelledAt        DateTime?
  cancellationReason String?       @db.Text

  members    FamilyMember[]
  recipients Recipient[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status, createdAt(sort: Desc)])
}

model FamilyMember {
  id                      String                     @id @default(cuid())
  familyId                String
  userId                  String
  role                    FamilyMemberRole           @default(payer)
  relationshipToRecipient FamilyMemberRelationship?
  isPrimaryContact        Boolean                    @default(false)
  addedAt                 DateTime                   @default(now())

  family Family @relation(fields: [familyId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([familyId, userId])
  @@index([familyId])
  @@index([userId])
}

model Recipient {
  id                  String    @id @default(cuid())
  familyId            String
  firstName           String
  lastName            String
  preferredName       String?
  dateOfBirth         DateTime? @db.Date
  phone               String?
  pronouns            String?
  interests           String?   @db.Text
  thingsToKnow        String?   @db.Text
  mobility            String?   @db.Text
  healthNotes         String?   @db.Text
  dietary             String?   @db.Text
  religiousObservance String?   @db.Text

  family Family @relation(fields: [familyId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([familyId])
}

enum FamilyStatus {
  prospect    // intake done, no first visit yet
  active      // visiting
  paused      // subscription paused
  cancelled   // subscription cancelled
  archived    // historical / removed from active lists
}

enum FamilyMemberRole {
  payer       // billing access; full account control
  viewer      // [Phase 2] read-only secondary household member
}

enum FamilyMemberRelationship {
  daughter
  son
  partner
  spouse
  sibling
  grandchild
  other
}

// ----------------------------------------------------------------------------
// Marketing context (SDD §12.10) — inbound enquiries from the public site.
// A new Enquiry is created by any of:
//   - the /contact form (source = contact_form)
//   - the /companions/join form (source = companion_application)
//   - a waitlist form for out-of-area visitors (source = waitlist) [Phase 2]
// The operator triages from /ops/enquiries. When an Enquiry becomes a paying
// customer, convertedToFamilyId is set and status moves to "converted".
// ----------------------------------------------------------------------------

model Enquiry {
  id                    String          @id @default(cuid())
  source                EnquirySource
  name                  String
  email                 String
  phone                 String?
  postcode              String?
  message               String          @db.Text
  status                EnquiryStatus   @default(new)
  assignedToOperatorId  String?
  consentMarketing      Boolean         @default(false)
  convertedToFamilyId   String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  // Soft foreign key — once a Family is created from this Enquiry, the
  // operator surface uses convertedToFamilyId to deep-link. No DB FK is
  // declared here because (a) we may want to allow merging two enquiries
  // into one Family later, and (b) cascading deletes between contexts
  // are deliberately avoided per the data conventions in SDD §12.1.

  @@index([status, createdAt(sort: Desc)])
  @@index([source, createdAt(sort: Desc)])
  @@index([email])
  @@index([convertedToFamilyId])
}

enum EnquirySource {
  contact_form
  waitlist
  companion_application
}

enum EnquiryStatus {
  new
  triaged
  converted
  closed
}

// ----------------------------------------------------------------------------
// Audit context (SDD §12.7) — append-only log of every sensitive action.
// Append-only is enforced at the DB layer by triggers; see migration
// 20260521..._add_audit_log_entry. Per DR-008, this lives in the same
// Postgres database as the rest of the app for v1 scale.
// ----------------------------------------------------------------------------

model AuditLogEntry {
  id          BigInt     @id @default(autoincrement())
  occurredAt  DateTime   @default(now())
  actorType   ActorType
  actorId     String?
  actorRole   String?
  actionType  ActionType
  targetType  String
  targetId    String?
  beforeState Json?
  afterState  Json?
  ip          String?
  userAgent   String?
  requestId   String?
  metadata    Json?

  @@index([occurredAt(sort: Desc)])
  @@index([actorId, occurredAt(sort: Desc)])
  @@index([targetType, targetId])
  @@index([actionType, occurredAt(sort: Desc)])
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------

// User roles per SDD §12.9.1. Lowercase snake_case to match the SDD spec
// exactly; Prisma generates idiomatic enum members on the TS side
// (`UserRole.family_payer`).
//
// Operator sub-roles enable least-privilege RBAC in the operator console
// (DR-013 spirit): a finance operator does not need access to safeguarding
// cases, a read_only operator cannot mutate, etc.
enum ActorType {
  user
  system
  integration
}

// Action categories per SDD §12.7.1. Granular enough to support meaningful
// log search ("show me every payment action by this operator last week")
// without exploding into one enum per concrete event type.
enum ActionType {
  create
  update
  delete
  read_sensitive   // operator opened a record containing PII
  state_change     // visit state machine, case state machine, etc.
  auth             // sign-in, sign-out, 2FA challenge
  payment          // any payment-context event
  consent          // recipient consent capture or revocation
  export           // data export by operator or by GDPR access request
}

enum UserRole {
  family_payer
  family_viewer            // [Phase 2] secondary household members
  companion
  operator_coordinator     // default operator role: bookings, matches, day-to-day ops
  operator_safeguarding    // safeguarding lead, case management
  operator_finance         // payment runs, invoicing, reconciliation
  operator_admin           // full access (you, Bassey)
  operator_read_only       // observer access (investor, auditor, advisor)
}
