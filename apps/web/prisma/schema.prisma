// YAIGC database schema v0
//
// Phase 1 scope: Auth.js v5 standard tables + minimal User extensions.
// Business tables (Family, FamilyMember, Recipient, Companion, Visit,
// AuditLogEntry) land in subsequent migrations as each context is built.
//
// Conventions:
// - `id` is cuid() everywhere (URL-friendly, sortable, no leaked counts)
// - Every business model has createdAt / updatedAt
// - Models holding personal data have deletedAt for soft-delete with audit
// - Migrations are append-only — never edit a committed migration

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Auth.js v5 standard tables (Prisma adapter)
// ----------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?

  // YAIGC business fields
  firstName String?
  lastName  String?
  role      UserRole @default(family_payer)

  // Password (optional, P.1). argon2id hash. NULL means the user is
  // magic-link only - they can set a password from /account/security.
  // passwordSetAt also acts as the "last changed" marker because we
  // never store a separate "last changed" column.
  passwordHash  String?
  passwordSetAt DateTime?

  // Passkeys (P.2). A user can register multiple authenticators
  // (iPhone, work laptop, hardware key) and use any to sign in.
  authenticators Authenticator[]

  // Audit
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  accounts                Account[]
  sessions                Session[]
  familyMembers           FamilyMember[]
  companion               Companion?
  proposedMatches         Match[]                @relation("MatchProposedBy")
  endedMatches            Match[]                @relation("MatchEndedBy")
  twoVisitReviewsLogged   Match[]                @relation("MatchTwoVisitReviewBy")
  submittedReports        PostVisitReport[]      @relation("ReportSubmittedBy")
  openedCases             SafeguardingCase[]     @relation("CaseOpenedBy")
  closedCases             SafeguardingCase[]     @relation("CaseClosedBy")
  assignedCases           SafeguardingCase[]     @relation("CaseAssignedTo")
  caseNotes               SafeguardingCaseNote[]
  rightToWorkVerified     CompanionApplication[] @relation("RightToWorkVerifiedBy")
  interviewsLogged        CompanionInterview[]   @relation("InterviewerOperator")
  badgesAwarded           CompanionBadge[]       @relation("BadgeAwardedBy")
  threadsAsOperator       Thread[]               @relation("ThreadsAsOperator")
  threadsAsParty          Thread[]               @relation("ThreadsAsParty")
  directThreadsAsFamily    Thread[]              @relation("DirectThreadsAsFamily")
  directThreadsAsCompanion Thread[]              @relation("DirectThreadsAsCompanion")
  messagesSent            Message[]
  messagesDeleted         Message[]              @relation("MessagesDeleted")
  attachmentsUploaded     MessageAttachment[]    @relation("AttachmentUploadedBy")
  familyTextRevisions     FamilyTextRevision[]   @relation("FamilyTextRevisionAuthor")
  relationshipNotes       RelationshipNote[]     @relation("RelationshipNoteOperator")

  @@index([email])
  @@index([role])
}

// Passkey / WebAuthn authenticator. One row per registered credential.
// Aligns with simplewebauthn's PublicKeyCredential shape: credentialID
// is the binary credential identifier returned by the device; counter
// is the signature counter we track for replay detection.
model Authenticator {
  id                   String    @id @default(cuid())
  userId               String
  // Stored as base64url text so we can use it in @@unique without
  // running into Postgres bytea index quirks.
  credentialID         String    @unique
  credentialPublicKey  Bytes
  counter              BigInt    @default(0)
  credentialDeviceType String    // 'singleDevice' | 'multiDevice'
  credentialBackedUp   Boolean
  transports           String?   // CSV: usb,ble,nfc,internal,hybrid
  nickname             String?   // user-given name e.g. "iPhone"
  createdAt            DateTime  @default(now())
  lastUsedAt           DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Short-lived challenge for WebAuthn registration + authentication.
// Single-use, single TTL (~5 min). Cleaned up on verify or expiry.
model WebAuthnChallenge {
  id        String   @id @default(cuid())
  challenge String   @unique
  userId    String?  // set for registration; may be null for auth before email known
  email     String?  // captured for auth flow when user typed email
  purpose   String   // 'registration' | 'authentication'
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  // P.3 additions. userAgent populated at sign-in for the device list
  // on /account; lastActiveAt is refreshed by the middleware on each
  // request so the device list shows when a session was last used.
  userAgent    String?
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
  @@index([userId, lastActiveAt(sort: Desc)])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@index([expires])
}

// ----------------------------------------------------------------------------
// Family context (SDD §12.2) — the buying side of the marketplace.
//
// One Family is a single customer relationship. It holds:
//   - one or more FamilyMembers (the payer plus optionally household members)
//   - one or more Recipients (the older adults receiving visits)
//   - subscriptions, payments, etc. (added in later stages)
//
// Address fields are intentionally flattened here rather than modelled as
// embedded composite types: simpler to query, simpler to migrate. JSON or
// Postgres composite types can come later if we need richer modelling.
//
// Sensitive PII fields (address, dateOfBirth, healthNotes, mobility,
// religiousObservance) carry an `isSensitive: true` access-control intent
// that the application layer should respect when surfacing data to
// non-operator-admin roles. The fields are not currently gated at the DB
// layer; that is operator_safeguarding / operator_admin RBAC work for a
// later stage.
// ----------------------------------------------------------------------------

model Family {
  id                 String        @id @default(cuid())
  status             FamilyStatus  @default(prospect)
  billingName        String
  intakeNotes        String?       @db.Text

  // Billing address (SDD §12.2.1 "billingAddress (embedded type) — for
  // invoicing, distinct from recipient address"). Flattened columns
  // rather than a composite type for query simplicity.
  billingAddressLine1 String?
  billingAddressLine2 String?
  billingCity         String?
  billingPostcode     String?
  billingCountry      String  @default("GB")

  // R.1 - "Shape of the relationship" memo, May 2026.
  //
  // whatWeAreHopingFor is the family-payer's emotional landscape -
  // not a goal, not a measurement, not displayed to the companion.
  // Read by the operator team during the fifth-visit reflection
  // call and the periodic check-in.
  //
  // checkInCadenceDays controls how often the operator team rings
  // the family payer for a "how does it feel?" call. Default 90
  // (quarterly); operator can override per family from
  // /ops/families/[id]. lastReflectionAt + lastCheckInAt drive the
  // Today-dashboard "due this week" cards. Memo deliberately
  // forbids the word "goals" and any measurement framework.
  whatWeAreHopingFor   String?  @db.Text
  checkInCadenceDays   Int      @default(90)
  lastReflectionAt     DateTime?
  lastCheckInAt        DateTime?

  joinedAt           DateTime      @default(now())
  cancelledAt        DateTime?
  cancellationReason String?       @db.Text

  members           FamilyMember[]
  recipients        Recipient[]
  matches           Match[]
  subscriptions     Subscription[]
  visits            Visit[]
  textRevisions     FamilyTextRevision[]
  relationshipNotes RelationshipNote[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status, createdAt(sort: Desc)])
}

model FamilyMember {
  id                      String                     @id @default(cuid())
  familyId                String
  userId                  String
  role                    FamilyMemberRole           @default(payer)
  relationshipToRecipient FamilyMemberRelationship?
  isPrimaryContact        Boolean                    @default(false)
  addedAt                 DateTime                   @default(now())

  family Family @relation(fields: [familyId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([familyId, userId])
  @@index([familyId])
  @@index([userId])
}

model Recipient {
  id                  String    @id @default(cuid())
  familyId            String
  firstName           String
  lastName            String
  preferredName       String?
  dateOfBirth         DateTime? @db.Date
  phone               String?
  pronouns            String?
  interests           String?   @db.Text
  thingsToKnow        String?   @db.Text
  mobility            String?   @db.Text
  healthNotes         String?   @db.Text
  dietary             String?   @db.Text
  religiousObservance String?   @db.Text

  // Visit address (SDD §12.2.3 "address (embedded type) — Full address.
  // Visible only to assigned companion and operators."). Currently no
  // DB-level RBAC; the application layer is the gate.
  addressLine1   String?
  addressLine2   String?
  addressCity    String?
  addressPostcode String?
  addressCountry String  @default("GB")

  // Consents (SDD §12.2.3). Booleans are the queryable current state.
  // The audit log captures every flip with the operator who made it,
  // the timestamp, and an evidence note in metadata — that is the
  // GDPR-grade record, not these flags.
  consentToVisits        Boolean @default(false)
  consentToPhotos        Boolean @default(false)
  consentToReportSharing Boolean @default(true)

  // R.1 - "Shape of the relationship" memo, May 2026.
  //
  // aboutTheRecipient is the family-payer-authored prose about who
  // this person is - what matters to them, what they enjoy, what
  // the companion should know before the first visit. Held lightly:
  // no length validation, no scoring, no required prompts. The
  // companion reads it before every visit (M.2.x companion visit
  // detail page block). Revision history lives on
  // FamilyTextRevision so the operator can compare month-1 to
  // month-12 - the change itself is signal.
  aboutTheRecipient String? @db.Text

  family            Family               @relation(fields: [familyId], references: [id])
  matches           Match[]
  subscriptions     Subscription[]
  visits            Visit[]
  safeguardingCases SafeguardingCase[]
  textRevisions     FamilyTextRevision[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([familyId])
}

enum FamilyStatus {
  prospect    // intake done, no first visit yet
  active      // visiting
  paused      // subscription paused
  cancelled   // subscription cancelled
  archived    // historical / removed from active lists
}

enum FamilyMemberRole {
  payer       // billing access; full account control
  viewer      // [Phase 2] read-only secondary household member
}

enum FamilyMemberRelationship {
  daughter
  son
  partner
  spouse
  sibling
  grandchild
  other
}

// ----------------------------------------------------------------------------
// Match (SDD §12.4.5) — the operator-proposed connection between a Family's
// Recipient and a Companion. Per DR-002, all matching is operator-led in v1
// (no self-serve algorithmic matching).
//
// Lifecycle:
//   proposed -> accepted (both sides confirmed via phone, captured by operator)
//             -> declined (with reason)
//             -> withdrawn (operator pulled before either side responded)
//
// Once accepted, the operator goes on to create a Subscription (Stage O.7.2)
// which generates the recurring Visits the family pays for.
// ----------------------------------------------------------------------------

model Match {
  id                   String      @id @default(cuid())
  familyId             String
  recipientId          String?     // null when the family has exactly one recipient
  candidateCompanionId String
  proposedByOperatorId String
  status               MatchStatus @default(proposed)
  rationale            String      @db.Text

  familyResponseAt        DateTime?
  companionResponseAt     DateTime?
  declineReason           String?   @db.Text
  // Action-reminder cron idempotency (single-shot nudges).
  familyReminderSentAt    DateTime?
  companionReminderSentAt DateTime?

  // Un-match (after acceptance). status=ended means a confirmed pairing
  // was separated. Distinct from declined/withdrawn which are
  // pre-acceptance outcomes. endReason drives both UI copy and any
  // downstream effects (safeguarding_concern auto-opens a case in O.7.5).
  endedAt           DateTime?
  endReason         MatchEndReason?
  endNote           String?        @db.Text
  endedByOperatorId String?

  // Cover companion (SDD Addendum §2). The named back-up who shadows the
  // primary on ~1 in 5 visits during the first two months, then steps in
  // when the primary is unavailable. coverCompanionId is *desired* at
  // match acceptance but not required - matches accept and visits start
  // even if cover is unassigned; the absence shows up as an ops nudge on
  // the today dashboard. coverIntroductionVisitsCompleted is incremented
  // when a PostVisitReport is filed for a visit whose
  // Visit.secondaryCompanionId is set; it feeds the "Cover introductions
  // due this week" dashboard card.
  coverCompanionId                String?
  coverIntroductionVisitsCompleted Int      @default(0)

  // Two-visit calibration review (SDD Addendum §4). After visit two is
  // completed, the operator team has 72 hours to conduct a structured
  // review with both the family and the companion: outcome continue /
  // adjust / reset, plus a short note visible to both sides. Distinct
  // from the fifth-visit reflection call (Stage R, family-only).
  twoVisitReviewScheduledFor DateTime?
  twoVisitReviewCompletedAt  DateTime?
  twoVisitReviewOutcome      TwoVisitReviewOutcome?
  twoVisitReviewNotes        String?   @db.Text
  twoVisitReviewByOperatorId String?

  // SDD Addendum §4.6 / Stage V. Per-channel capture for the review.
  // The recipient's voice reaches the platform through up to four
  // routes; each lands in its own nullable field so the review surface
  // can honestly say which channels reached the recipient this round.
  // The companion's post-visit reports already capture the visit-by-
  // visit observation (PostVisitReport.recipientPerspective from V.2);
  // the three fields below are operator notes from the structured
  // debrief calls + the optional recipient call.
  twoVisitReviewCompanionCallNotes String?   @db.Text
  twoVisitReviewFamilyCallNotes    String?   @db.Text
  twoVisitReviewRecipientCallNotes String?   @db.Text
  twoVisitReviewRecipientCalledAt  DateTime?

  family           Family            @relation(fields: [familyId], references: [id])
  recipient        Recipient?        @relation(fields: [recipientId], references: [id])
  companion        Companion         @relation(fields: [candidateCompanionId], references: [id])
  coverCompanion   Companion?        @relation("MatchCover", fields: [coverCompanionId], references: [id])
  proposedBy       User              @relation("MatchProposedBy", fields: [proposedByOperatorId], references: [id])
  endedBy          User?             @relation("MatchEndedBy", fields: [endedByOperatorId], references: [id])
  twoVisitReviewBy User?             @relation("MatchTwoVisitReviewBy", fields: [twoVisitReviewByOperatorId], references: [id])
  subscription     Subscription?
  safeguardingCase SafeguardingCase?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([familyId, status])
  @@index([candidateCompanionId, status])
  @@index([status, createdAt(sort: Desc)])
  @@index([coverCompanionId, status])
  @@index([twoVisitReviewScheduledFor, twoVisitReviewCompletedAt])
}

enum MatchStatus {
  proposed
  accepted
  declined
  withdrawn
  ended
}

enum MatchEndReason {
  not_a_fit
  scheduling_conflict
  recipient_circumstances_changed
  recipient_passed_away
  companion_circumstances_changed
  safeguarding_concern
  other
}

// SDD Addendum §4. The three outcomes the operator team can record after
// the two-visit calibration review.
//   continue - match is working, no changes
//   adjust   - match is working but with one or two specific changes,
//              communicated clearly to both sides in the review note
//   reset    - match is not working; family is rematched with high
//              priority (24h SLA per §4.5)
enum TwoVisitReviewOutcome {
  continue
  adjust
  reset
}

// ----------------------------------------------------------------------------
// Subscription (SDD §12.4.1) — the recurring schedule a Family pays for. A
// single Subscription pins one Recipient to one Companion at a fixed day +
// time + duration + hourly rate. Stripe is not wired in v1 (DR-005 deferred);
// stripeSubscriptionId is nullable until the payments stage lands.
//
// Visits (Stage O.7.3) are generated from a Subscription's schedule. The
// Subscription itself is metadata - pause/cancel here ripples to which
// future visits get created.
// ----------------------------------------------------------------------------

model Subscription {
  id                   String                @id @default(cuid())
  familyId             String
  recipientId          String
  companionId          String
  originatingMatchId   String?               @unique
  status               SubscriptionStatus    @default(active)
  frequency            SubscriptionFrequency
  dayOfWeek            DayOfWeek
  startTime            String                // "HH:MM" 24h, local UK time
  durationMinutes      Int
  hourlyRate           Decimal               @db.Decimal(8, 2)
  stripeSubscriptionId String?               @unique
  startedAt            DateTime              @default(now())
  pauseStartAt         DateTime?
  pauseEndAt           DateTime?
  endedAt              DateTime?
  cancellationReason   String?               @db.Text
  notes                String?               @db.Text

  // Pause/cancel requests submitted by the family via /family/subscription.
  // The family does not change subscription state directly; they flag an
  // intent for operator review. Cleared by transitionSubscription when the
  // matching status transition lands. Both nullable; non-null = open request.
  pauseRequestedAt      DateTime?
  pauseRequestedReason  String?  @db.Text
  cancelRequestedAt     DateTime?
  cancelRequestedReason String?  @db.Text

  family           Family    @relation(fields: [familyId], references: [id])
  recipient        Recipient @relation(fields: [recipientId], references: [id])
  companion        Companion @relation(fields: [companionId], references: [id])
  originatingMatch Match?    @relation(fields: [originatingMatchId], references: [id])
  visits           Visit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([familyId, status])
  @@index([companionId, status])
  @@index([status, dayOfWeek])
}

// ----------------------------------------------------------------------------
// Visit (SDD §12.4.2) — a single companionship visit. Generated from a
// Subscription's recurring schedule. The state machine (SDD §11.1) is
// driven by the operator in v1 since neither the companion portal nor the
// family portal exists yet — the operator updates state based on phone
// calls from the companion.
//
// State flow:
//   scheduled -> confirmed -> en_route -> in_progress -> completed -> reported
//             \-> cancelled_by_family | cancelled_by_companion | cancelled_by_operator
//             \-> no_show_companion | no_show_recipient
//
// scheduledStartAt is stored as UTC, computed from the Subscription's
// dayOfWeek + startTime (HH:MM UK local) via a small Intl-based helper
// that handles BST/GMT correctly. actualStartAt / actualEndAt are
// captured when the operator moves the visit through in_progress and
// completed — those drive billing accuracy.
// ----------------------------------------------------------------------------

model Visit {
  id                       String     @id @default(cuid())
  subscriptionId           String
  familyId                 String
  recipientId              String
  companionId              String

  state                    VisitState @default(scheduled)
  scheduledStartAt         DateTime
  scheduledDurationMinutes Int
  actualStartAt            DateTime?
  actualEndAt              DateTime?

  agreedActivity           String?    @db.Text
  safetyFlags              String?    @db.Text

  cancellationReason       String?    @db.Text
  cancellationActor        CancellationActor?

  // SDD Addendum §2.4. Populated on cover-introduction visits where the
  // named cover is present alongside the primary. The post-visit report
  // is filed by the primary; the cover's presence is captured here in
  // the visit record rather than generating a second report.
  secondaryCompanionId String?

  // SDD Addendum §2.5 / Stage U.4. Cover-introduction scheduling
  // suggestion. Set by generateNextVisitForSubscription on every 5th
  // visit within the first 60 days of the subscription's startedAt
  // (the "1 in 5 during the first two months" rule from §2.1).
  // Surfaces as a hint on the visit edit form so the operator can
  // toggle the cover picker on with one click. Never auto-assigns the
  // cover — operator agency is preserved.
  coverSuggested Boolean @default(false)

  stateChangedAt              DateTime   @default(now())
  reminderSentAt              DateTime?  // 24h-before reminder; null until the cron fires
  confirmationReminderSentAt  DateTime?  // single-fire nudge for unconfirmed visits ~4h out
  reportReminderSentAt        DateTime?  // single-fire nudge for completed visits without a report

  subscription       Subscription       @relation(fields: [subscriptionId], references: [id])
  family             Family             @relation(fields: [familyId], references: [id])
  recipient          Recipient          @relation(fields: [recipientId], references: [id])
  companion          Companion          @relation(fields: [companionId], references: [id])
  secondaryCompanion Companion?         @relation("VisitSecondaryCompanion", fields: [secondaryCompanionId], references: [id])
  report             PostVisitReport?
  safeguardingCases  SafeguardingCase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([state, scheduledStartAt])
  @@index([subscriptionId, scheduledStartAt(sort: Desc)])
  @@index([companionId, scheduledStartAt])
  @@index([familyId, scheduledStartAt])
  @@index([secondaryCompanionId, scheduledStartAt])
}

// ----------------------------------------------------------------------------
// PostVisitReport (SDD §12.4.3) — companion's report after each Visit. The
// family-facing summary is a redacted view: it includes what happened and
// wellbeing observations, but NOT thingsToFlag (operator-only). When the
// recipient has consentToReportSharing=false, the family email is skipped
// and the audit log captures that.
//
// In v1 the operator submits the report on behalf of the companion (from
// a phone call / text) since the companion portal is not built. The
// submittedByOperatorId column carries the operator's User id. When the
// companion portal lands (Phase 2) the same row will be written by the
// companion's session.
//
// PostVisitReportPhoto (SDD §12.4.4) is deferred to a follow-up stage.
// ----------------------------------------------------------------------------

model PostVisitReport {
  id                    String           @id @default(cuid())
  visitId               String           @unique
  companionId           String

  actualDurationMinutes Int
  whatHappened          String           @db.Text
  howWereThey           WellbeingRating
  howWereTheyNote       String?          @db.Text
  thingsToFlag          String?          @db.Text

  // SDD Addendum §4.6 / Stage V.2. Companion-relayed reading of the
  // recipient's experience of the visit. Optional - companions write
  // it when the recipient communicated something worth capturing.
  // Framed as the companion's reading, not a verbatim quote.
  recipientPerspective  String?          @db.Text

  submittedAt           DateTime         @default(now())
  submittedByOperatorId String?
  deliveredToFamilyAt   DateTime?

  visit            Visit                  @relation(fields: [visitId], references: [id])
  companion        Companion              @relation(fields: [companionId], references: [id])
  submittedBy      User?                  @relation("ReportSubmittedBy", fields: [submittedByOperatorId], references: [id])
  photos           PostVisitReportPhoto[]
  safeguardingCase SafeguardingCase?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companionId, submittedAt(sort: Desc)])
  @@index([submittedAt(sort: Desc)])
}

// PostVisitReportPhoto (SDD §12.4.4) — photos that go alongside a
// post-visit report. Per-photo recipientConsentConfirmed is required by
// law (recipient must consent to images of themselves being shared).
// Files live on disk under /home/username/igc-platform/uploads/post-visit-reports/
// <reportId>/. The filename is server-generated; the original client
// filename is discarded.
model PostVisitReportPhoto {
  id                        String   @id @default(cuid())
  postVisitReportId         String
  filename                  String
  contentType               String
  sizeBytes                 Int
  recipientConsentConfirmed Boolean  @default(false)
  uploadedAt                DateTime @default(now())

  report PostVisitReport @relation(fields: [postVisitReportId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([postVisitReportId])
}

enum WellbeingRating {
  cheerful
  quiet
  tired
  unwell
  distressed
  other
}

// ----------------------------------------------------------------------------
// SafeguardingCase (SDD §12.6) — the operator-facing workflow for concerns
// flagged on the platform. Cases auto-open from two triggers:
//   1. PostVisitReport with non-empty thingsToFlag (severity defaults to
//      medium) - one case per report (relatedReportId @unique)
//   2. Match ended with reason=safeguarding_concern (severity defaults to
//      high) - one case per match (relatedMatchId @unique)
// Operators can also open cases manually.
//
// Case workflow: open -> under_review -> actioned -> closed. Closure
// requires both a category and a note. Assignment defaults to no-one;
// any operator can pick a case up.
//
// Notes (SafeguardingCaseNote) form a linear thread under the case. They
// are operator-only - never surfaced to the family or companion.
// ----------------------------------------------------------------------------

model SafeguardingCase {
  id                    String                       @id @default(cuid())
  status                SafeguardingStatus           @default(open)
  severity              SafeguardingSeverity         @default(medium)
  summary               String                       @db.Text

  subjectRecipientId    String?
  relatedVisitId        String?
  relatedReportId       String?                      @unique
  relatedMatchId        String?                      @unique

  openedAt              DateTime                     @default(now())
  openedByOperatorId    String?                      // null when system-opened
  assignedToOperatorId  String?
  closedAt              DateTime?
  closedByOperatorId    String?
  closureCategory       SafeguardingClosureCategory?
  closureNote           String?                      @db.Text

  subjectRecipient Recipient?             @relation(fields: [subjectRecipientId], references: [id])
  relatedVisit     Visit?                 @relation(fields: [relatedVisitId], references: [id])
  relatedReport    PostVisitReport?       @relation(fields: [relatedReportId], references: [id])
  relatedMatch     Match?                 @relation(fields: [relatedMatchId], references: [id])
  openedBy         User?                  @relation("CaseOpenedBy", fields: [openedByOperatorId], references: [id])
  closedBy         User?                  @relation("CaseClosedBy", fields: [closedByOperatorId], references: [id])
  assignedTo       User?                  @relation("CaseAssignedTo", fields: [assignedToOperatorId], references: [id])
  notes            SafeguardingCaseNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, openedAt(sort: Desc)])
  @@index([assignedToOperatorId, status])
  @@index([subjectRecipientId, openedAt(sort: Desc)])
  @@index([severity, status])
}

model SafeguardingCaseNote {
  id               String   @id @default(cuid())
  caseId           String
  authorOperatorId String?
  body             String   @db.Text
  createdAt        DateTime @default(now())

  case   SafeguardingCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  author User?            @relation(fields: [authorOperatorId], references: [id])

  @@index([caseId, createdAt])
}

enum SafeguardingStatus {
  open
  under_review
  actioned
  closed
}

enum SafeguardingSeverity {
  low
  medium
  high
  critical
}

enum SafeguardingClosureCategory {
  no_action_needed
  followed_up_with_family
  followed_up_with_companion
  companion_removed
  external_referral
  other
}

enum VisitState {
  scheduled
  confirmed
  en_route
  in_progress
  completed
  reported
  cancelled_by_family
  cancelled_by_companion
  cancelled_by_operator
  no_show_companion
  no_show_recipient
}

enum CancellationActor {
  family
  companion
  operator
}

enum SubscriptionStatus {
  active
  paused
  canceled
}

enum SubscriptionFrequency {
  weekly
  biweekly
  monthly
}

enum DayOfWeek {
  mon
  tue
  wed
  thu
  fri
  sat
  sun
}

// ----------------------------------------------------------------------------
// Companion context (SDD §12.3) — the supply side of the marketplace.
//
// CompanionApplication holds an inbound application from /companions/join
// and the operator pipeline (received -> in_triage -> phone_screen ->
// interview -> vetting -> complete | declined | withdrawn).
//
// Approval at status=complete creates the Companion row and links the
// application to it. Companion is the active record that the operator
// console, the booking engine, and (later) the companion portal consume.
//
// Deferred to later stages:
//   - CompanionReference (Stage O.6.1) — two referees per application
//   - TrainingModule + TrainingCompletion (Stage O.6.2)
//   - DBS encryption at rest (Stage O.6.2) — currently TEXT, app layer
//     gates access by operator role
//   - Stripe Connect onboarding (Stage O.7+)
//   - Availability calendar (Phase 2)
// ----------------------------------------------------------------------------

model CompanionApplication {
  id     String                     @id @default(cuid())
  status CompanionApplicationStatus @default(received)

  firstName String
  lastName  String
  email     String
  phone     String
  postcode  String

  availabilitySummary String @db.Text
  availabilitySlots   Json?
  whyJoinReason       String @db.Text
  aboutYou            String @db.Text

  rightToWork            Boolean // self-attestation by applicant
  backgroundCheckConsent Boolean

  // Right-to-work compliance (SDD §5.4). The applicant declares the
  // type of right they have (UK national, settled, visa, etc.) and
  // submits supporting evidence (passport scan, BRP, gov.uk share-code
  // PDF). The operator runs the share code at
  // gov.uk/view-right-to-work and captures the verification result
  // below. dateOfBirth is required for the share-code check.
  dateOfBirth                     DateTime?       @db.Date
  rightToWorkType                 RightToWorkType?
  rightToWorkShareCode            String?
  rightToWorkExpiresAt            DateTime?       @db.Date
  rightToWorkVerifiedAt           DateTime?
  rightToWorkVerifiedByOperatorId String?
  rightToWorkVerificationNote     String?         @db.Text

  // Operator pipeline metadata
  triageNotes          String? @db.Text
  declineReason        String? @db.Text
  assignedToOperatorId String?

  // SDD Addendum §3.4 - Phase 0 questionnaire. Four optional
  // open-ended prompts that probe the cultural-fit dimensions before
  // the interview happens. Nullable because the apply form may have
  // been submitted before these fields existed; new submissions get
  // the prompts but may skip them.
  motivation             String? @db.Text // "What brings you to this work?"
  experienceAlongside    String? @db.Text // "Tell us about a time you were alongside a friend, family member, or neighbour who needed company"
  yearsSettledLocally    String? @db.Text // "How long have you been settled in this part of the UK?"
  weeklyStabilityNote    String? @db.Text // "How stable does your week look over the next six months?"

  companion         Companion?
  rightToWorkVerifiedBy User?               @relation("RightToWorkVerifiedBy", fields: [rightToWorkVerifiedByOperatorId], references: [id])
  documents         CompanionDocument[]
  interviews        CompanionInterview[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status, createdAt(sort: Desc)])
  @@index([email])
  @@index([rightToWorkVerifiedAt])
}

// SDD Addendum §3. One row per interview event against a
// CompanionApplication. Operator-internal; rubric values are
// judgement bands, not numeric scores. Pre-interview Phase 0 answers
// live on the CompanionApplication itself; this row captures what the
// operator read in the actual conversation.
model CompanionInterview {
  id                     String                  @id @default(cuid())
  companionApplicationId String
  kind                   InterviewKind
  happenedAt             DateTime
  interviewerOperatorId  String

  notes                  String                  @db.Text
  recommendation         InterviewRecommendation

  // Cultural-fit dimensions (addendum §3.2). All nullable - a phone
  // screen often cannot read every dimension, and the operator may
  // explicitly leave a band blank when they have not formed a view.
  ukSettledness           UkSettledness?
  communityTemperament    RubricBand?
  readsARoom              RubricBand?
  schedulingStability     RubricBand?
  motivationBeyondIncome  MotivationBand?

  // Existing harder gates (addendum §3.3).
  dbsClearable            VettingState?
  referencesPositive      VettingState?
  engagementTermsComfort  ComfortBand?
  trainingAcceptance      ComfortBand?

  application CompanionApplication @relation(fields: [companionApplicationId], references: [id], onDelete: Cascade)
  interviewer User                 @relation("InterviewerOperator", fields: [interviewerOperatorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companionApplicationId, happenedAt(sort: Desc)])
  @@index([interviewerOperatorId, happenedAt(sort: Desc)])
}

// CompanionDocument — uploaded evidence for right-to-work, DBS, and
// other compliance artefacts. Lives on the application so a single FK
// covers both pre-approval (file uploaded at intake) and post-approval
// (Companion uploads a replacement after expiry). Files are stored in
// S3 under companion-documents/<applicationId>/<filename>; bucket is
// private and the /api/companion-documents/[id] route auth-gates each
// fetch to operator + the owning companion.
model CompanionDocument {
  id                  String                @id @default(cuid())
  companionApplicationId String
  kind                CompanionDocumentKind
  filename            String                // server-generated; original client filename discarded
  contentType         String
  sizeBytes           Int
  description         String?               @db.Text
  uploadedAt          DateTime              @default(now())
  uploadedByActorType ActorType
  uploadedByActorId   String?
  // Soft delete - operator-controlled. Audit trail rules out hard delete.
  archivedAt          DateTime?
  archivedByOperatorId String?
  archivedReason      String?               @db.Text

  application CompanionApplication @relation(fields: [companionApplicationId], references: [id], onDelete: Cascade)

  @@index([companionApplicationId, uploadedAt(sort: Desc)])
  @@index([kind, uploadedAt(sort: Desc)])
}

enum RightToWorkType {
  british_irish_passport
  settled_status
  pre_settled_status
  skilled_worker_visa
  graduate_visa
  student_visa
  dependant_visa
  indefinite_leave_to_remain
  other
}

enum CompanionDocumentKind {
  passport
  brp                  // Biometric Residence Permit
  share_code_pdf
  visa_letter
  ilr_document
  dbs_certificate
  driver_licence
  photo_id
  proof_of_address
  insurance_certificate
  other
}

model Companion {
  id            String              @id @default(cuid())
  userId        String              @unique
  applicationId String              @unique
  status        CompanionStatus     @default(onboarding)

  firstName     String  // public-facing
  lastName      String  // operator-only
  photoUrl      String?
  photoFilename String? // server-generated; objects live at s3://.../companion-profiles/<id>/<filename>
  bio           String? @db.Text
  borough       CompanionBorough
  interests     String? @db.Text

  availability         Json?
  maxConcurrentMatches Int  @default(4)

  // M.2 - operator_admin gate for direct family <-> companion messaging.
  // When false (default), the companion cannot be reached outside the
  // operator-mediated thread. When true, every active/accepted Match
  // unlocks a FAMILY_COMPANION thread between this companion's User
  // record and the family_payer User on the other side of the match.
  // Ops retains full read access to every direct thread.
  directMessagingEnabled Boolean @default(false)

  // Compliance documents. dbsCertificateNumber stored as TEXT for now;
  // app-layer access gating only. DB-layer encryption is Stage O.6.2.
  dbsCertificateNumber String?
  dbsIssuedAt          DateTime? @db.Date
  dbsRenewalDueAt      DateTime? @db.Date
  insuranceProvider    String?
  insuranceExpiresAt   DateTime? @db.Date

  // Driver's licence. Optional - not every companion drives. Number is
  // a free text field; pattern varies by issuing country. The expiry
  // date feeds the compliance dashboard alongside DBS and insurance.
  driverLicenceNumber    String?
  driverLicenceExpiresAt DateTime? @db.Date

  // Full home address. The application captures postcode only; once
  // approved we keep a proper address on the Companion record. Used
  // for the pre-accept travel-time estimate, future routing, and the
  // operator-facing summary. PII - operator-only.
  addressLine1     String?
  addressLine2     String?
  addressCity      String?
  addressPostcode  String?
  addressCountry   String  @default("GB")

  // Optional preference - how far the companion is happy to travel
  // from home for a visit. Surfaced as a soft filter when proposing
  // matches; null means "no preference stated".
  maxTravelMiles   Int?

  // Payments. Stripe Connect onboarding is deferred to Stage O.7+.
  stripeConnectedAccountId String?
  engagementType           CompanionEngagementType @default(worker)
  hourlyRate               Decimal                 @default(12.00) @db.Decimal(10, 2)

  user            User                 @relation(fields: [userId], references: [id])
  application     CompanionApplication @relation(fields: [applicationId], references: [id])
  matches         Match[]
  coverMatches    Match[]              @relation("MatchCover")
  subscriptions   Subscription[]
  visits          Visit[]
  secondaryVisits Visit[]              @relation("VisitSecondaryCompanion")
  reports         PostVisitReport[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  badges        CompanionBadge[]

  @@index([status])
  @@index([borough, status])
  @@index([dbsRenewalDueAt])
}

// Operator-mediated messaging thread. Always two parties: an operator
// (the platform side) and one of the customer-side users (a family
// payer or a companion). v1 deliberately disallows direct family <->
// companion threads; the operator is always in the loop. Per-side
// lastReadAt and lastNotifiedAt drive unread badges and the 5-minute
// email-debounce.
// M.2.1 - Threads come in three flavours, distinguished by `kind`:
//   OPS_FAMILY        operator <-> family_member user      (M.1)
//   OPS_COMPANION     operator <-> companion user          (M.1)
//   FAMILY_COMPANION  family_member <-> companion user     (M.2)
// The two participant pairs (operatorId/partyId vs familyUserId/companionUserId)
// are mutually exclusive: operator-mediated threads use the first pair,
// direct threads use the second. Prisma can't express that invariant in
// the DSL, so it lives in messaging.ts on every read/write path.
model Thread {
  id            String     @id @default(cuid())
  kind          ThreadKind
  subject       String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  lastMessageAt DateTime   @default(now())

  // Operator-mediated participants (kind = OPS_FAMILY | OPS_COMPANION).
  operatorId String?
  partyId    String?
  partyRole  String? // 'family_member' | 'companion' snapshot

  // Direct-thread participants (kind = FAMILY_COMPANION).
  familyUserId    String?
  companionUserId String?

  // Per-side read + email-notification timestamps. The participant pair
  // not in use for a given thread leaves its timestamps NULL.
  operatorLastReadAt      DateTime?
  partyLastReadAt         DateTime?
  operatorLastNotifiedAt  DateTime?
  partyLastNotifiedAt     DateTime?
  familyLastReadAt        DateTime?
  companionLastReadAt     DateTime?
  familyLastNotifiedAt    DateTime?
  companionLastNotifiedAt DateTime?

  operator      User?               @relation("ThreadsAsOperator",        fields: [operatorId],      references: [id])
  party         User?               @relation("ThreadsAsParty",           fields: [partyId],         references: [id])
  familyUser    User?               @relation("DirectThreadsAsFamily",    fields: [familyUserId],    references: [id])
  companionUser User?               @relation("DirectThreadsAsCompanion", fields: [companionUserId], references: [id])
  messages      Message[]
  attachments   MessageAttachment[] @relation("ThreadAttachments")

  @@index([kind])
  @@index([operatorId, lastMessageAt(sort: Desc)])
  @@index([partyId, lastMessageAt(sort: Desc)])
  @@index([familyUserId, lastMessageAt(sort: Desc)])
  @@index([companionUserId, lastMessageAt(sort: Desc)])
}

enum ThreadKind {
  OPS_FAMILY
  OPS_COMPANION
  FAMILY_COMPANION
}

model Message {
  id        String   @id @default(cuid())
  threadId  String
  senderId  String
  body      String   @db.Text
  createdAt DateTime @default(now())

  // M.3.1 - sender-side soft delete. When deletedAt is set, the
  // counterpart renders a "Message deleted" tombstone but the row +
  // body stay on disk so safeguarding investigations can still
  // reconstruct the conversation via the audit log. operator_admins
  // viewing FAMILY_COMPANION threads on the oversight tab also see
  // the original body with a strike-through marker. deletedByUserId
  // is always the sender today; the FK is in place so a future
  // moderation feature would not need a schema change.
  deletedAt        DateTime?
  deletedByUserId  String?

  thread      Thread              @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender      User                @relation(fields: [senderId], references: [id])
  deletedBy   User?               @relation("MessagesDeleted", fields: [deletedByUserId], references: [id])
  attachments MessageAttachment[]

  @@index([threadId, createdAt(sort: Desc)])
}

// M.1.2 - File / photo / video attachments hung off a Message. Two
// upload paths land here: a pre-upload via /api/message-attachments
// (returning an unbound row with messageId = null), and a bind step
// inside sendMessage that sets messageId once the parent Message is
// created. Cascade-delete with the Message because attachments without
// a parent message are not useful on their own.
model MessageAttachment {
  id               String   @id @default(cuid())
  threadId         String   // scope for the auth-gate; never changes
  messageId        String?  // null until the bind step in sendMessage
  uploadedById     String   // user who initiated the upload
  filename         String   // server-generated random hex + extension
  originalFilename String?  // best-effort client-supplied label
  contentType      String
  sizeBytes        Int
  width            Int?     // images only
  height           Int?     // images only
  createdAt        DateTime @default(now())

  thread     Thread   @relation("ThreadAttachments", fields: [threadId], references: [id], onDelete: Cascade)
  message    Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  uploadedBy User     @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id])

  @@index([threadId])
  @@index([messageId])
}

// Internal-only descriptive labels operators attach to a companion -
// languages spoken, skills, contexts (dementia experience, drives,
// first-aid trained). Not visible to families. They eventually feed
// match scoring. Tiers based on visit count are NOT stored here -
// they are derived live from Visit history.
model CompanionBadge {
  id                  String   @id @default(cuid())
  companionId         String
  slug                String   // matches a key in lib/badges.ts catalogue
  awardedAt           DateTime @default(now())
  awardedByOperatorId String?

  companion   Companion @relation(fields: [companionId], references: [id], onDelete: Cascade)
  awardedBy   User?     @relation("BadgeAwardedBy", fields: [awardedByOperatorId], references: [id])

  @@unique([companionId, slug])
  @@index([slug])
}

enum CompanionApplicationStatus {
  received
  in_triage
  phone_screen
  interview
  vetting
  complete
  declined
  withdrawn
}

// SDD Addendum §3.3. The interview rubric is operator-internal and
// never customer-facing. Three event kinds map onto the existing
// application status pipeline: a phone screen, an in-person interview,
// and a final sign-off. final is the gate that promotes the
// application to vetting → complete.
enum InterviewKind {
  phone_screen
  in_person
  final
}

// Operator's read at the close of an interview. proceed = move to the
// next interview in the pipeline; second_interview = surface for a
// second pair of eyes (per addendum §3.6); decline = stop the pipeline
// for this applicant; accept = used on a final-kind interview to
// promote the application to vetting.
enum InterviewRecommendation {
  proceed
  second_interview
  decline
  accept
}

// Soft Likert vocabulary for the three behavioural cultural-fit
// dimensions: community-driven temperament, ability to read a room,
// scheduling stability. Deliberately not numeric - the rubric is a
// judgement aid, not a scored assessment.
enum RubricBand {
  strong
  present
  unclear
  absent
}

// UK settledness is a soft preference (addendum §3.6 working answer):
// five years of residence is the target, three to five is a yellow
// flag, under three is a meaningful concern, n_a covers cases where
// the dimension does not apply (e.g. UK national).
enum UkSettledness {
  unclear
  five_plus
  three_to_five
  under_three
  n_a
}

// "Money is meaningful but not the primary motivation." Operator
// reads from the interview answer to "what brings you to this work?".
enum MotivationBand {
  clear
  mixed
  primarily_financial
}

// Harder vetting gates: DBS clearable + references positive. Uses
// not_taken_yet because the check or the calls may not have happened
// by the time the interview is logged.
enum VettingState {
  yes
  no
  unknown
  not_taken_yet
}

// Comfort gates: engagement terms + training requirement. concerns
// captures candidates who are not a flat "no" but want to talk it
// through before agreeing.
enum ComfortBand {
  yes
  concerns
  no
}

enum CompanionStatus {
  onboarding
  active
  suspended
  archived
}

enum CompanionBorough {
  south_manchester
  trafford
  stockport
  salford
}

enum CompanionEngagementType {
  self_employed
  worker
  employed
}

// ----------------------------------------------------------------------------
// Marketing context (SDD §12.10) — inbound enquiries from the public site.
// A new Enquiry is created by any of:
//   - the /contact form (source = contact_form)
//   - the /companions/join form (source = companion_application)
//   - a waitlist form for out-of-area visitors (source = waitlist) [Phase 2]
// The operator triages from /ops/enquiries. When an Enquiry becomes a paying
// customer, convertedToFamilyId is set and status moves to "converted".
// ----------------------------------------------------------------------------

model Enquiry {
  id                    String          @id @default(cuid())
  source                EnquirySource
  name                  String
  email                 String
  phone                 String?
  postcode              String?
  message               String          @db.Text
  status                EnquiryStatus   @default(new)
  assignedToOperatorId  String?
  consentMarketing      Boolean         @default(false)
  convertedToFamilyId   String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  // Soft foreign key — once a Family is created from this Enquiry, the
  // operator surface uses convertedToFamilyId to deep-link. No DB FK is
  // declared here because (a) we may want to allow merging two enquiries
  // into one Family later, and (b) cascading deletes between contexts
  // are deliberately avoided per the data conventions in SDD §12.1.

  @@index([status, createdAt(sort: Desc)])
  @@index([source, createdAt(sort: Desc)])
  @@index([email])
  @@index([convertedToFamilyId])
}

enum EnquirySource {
  contact_form
  waitlist
  companion_application
}

enum EnquiryStatus {
  new
  triaged
  converted
  closed
}

// ----------------------------------------------------------------------------
// Audit context (SDD §12.7) — append-only log of every sensitive action.
// Append-only is enforced at the DB layer by triggers; see migration
// 20260521..._add_audit_log_entry. Per DR-008, this lives in the same
// Postgres database as the rest of the app for v1 scale.
// ----------------------------------------------------------------------------

model AuditLogEntry {
  id          BigInt     @id @default(autoincrement())
  occurredAt  DateTime   @default(now())
  actorType   ActorType
  actorId     String?
  actorRole   String?
  actionType  ActionType
  targetType  String
  targetId    String?
  beforeState Json?
  afterState  Json?
  ip          String?
  userAgent   String?
  requestId   String?
  metadata    Json?

  @@index([occurredAt(sort: Desc)])
  @@index([actorId, occurredAt(sort: Desc)])
  @@index([targetType, targetId])
  @@index([actionType, occurredAt(sort: Desc)])
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------

// User roles per SDD §12.9.1. Lowercase snake_case to match the SDD spec
// exactly; Prisma generates idiomatic enum members on the TS side
// (`UserRole.family_payer`).
//
// Operator sub-roles enable least-privilege RBAC in the operator console
// (DR-013 spirit): a finance operator does not need access to safeguarding
// cases, a read_only operator cannot mutate, etc.
enum ActorType {
  user
  system
  integration
}

// Action categories per SDD §12.7.1. Granular enough to support meaningful
// log search ("show me every payment action by this operator last week")
// without exploding into one enum per concrete event type.
enum ActionType {
  create
  update
  delete
  read_sensitive   // operator opened a record containing PII
  state_change     // visit state machine, case state machine, etc.
  auth             // sign-in, sign-out, 2FA challenge
  payment          // any payment-context event
  consent          // recipient consent capture or revocation
  export           // data export by operator or by GDPR access request
}

enum UserRole {
  family_payer
  family_viewer            // [Phase 2] secondary household members
  companion
  operator_coordinator     // default operator role: bookings, matches, day-to-day ops
  operator_safeguarding    // safeguarding lead, case management
  operator_finance         // payment runs, invoicing, reconciliation
  operator_admin           // full access (you, Bassey)
  operator_read_only       // observer access (investor, auditor, advisor)
}

// ----------------------------------------------------------------------------
// R.1 - Shape of the relationship (design memo, May 2026).
//
// Two prose fields - Recipient.aboutTheRecipient (companion-facing) +
// Family.whatWeAreHopingFor (operator-only) - back a deliberately
// non-clinical version of "intake". Both are family-payer-authored and
// edit-history tracked via FamilyTextRevision so the operator can read
// month-1 vs month-12 and notice drift.
//
// RelationshipNote captures the operator's free-text note from the
// fifth-visit reflection call and from the periodic check-in. There is
// no scoring, no progress field, no satisfaction rating - the memo is
// emphatic that measurement would corrupt the post-visit reports it
// would be measuring. Cadence default 90 days (quarterly) is held on
// Family.checkInCadenceDays; operator can override per family on
// /ops/families/[id].
// ----------------------------------------------------------------------------

model FamilyTextRevision {
  id           String                  @id @default(cuid())
  familyId     String
  // Populated for `aboutTheRecipient` revisions (the field lives on
  // Recipient, one row per parent the family is visiting). NULL for
  // `whatWeAreHopingFor` revisions (one row per family). The app
  // layer enforces this invariant; the DB just exposes a nullable.
  recipientId  String?
  field        FamilyTextRevisionField
  body         String                  @db.Text
  // Optional because not every save will be by a logged-in author -
  // future intake-form imports or admin bulk-edits may have no
  // session. Today every save will carry the family payer's userId.
  authorUserId String?
  createdAt    DateTime                @default(now())

  family    Family     @relation(fields: [familyId],    references: [id], onDelete: Cascade)
  recipient Recipient? @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  author    User?      @relation("FamilyTextRevisionAuthor", fields: [authorUserId], references: [id])

  @@index([familyId, field, createdAt(sort: Desc)])
  @@index([recipientId, createdAt(sort: Desc)])
}

enum FamilyTextRevisionField {
  aboutTheRecipient
  whatWeAreHopingFor
}

model RelationshipNote {
  id              String                @id @default(cuid())
  familyId        String
  operatorUserId  String
  callType        RelationshipNoteKind
  body            String                @db.Text
  createdAt       DateTime              @default(now())

  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  operator User   @relation("RelationshipNoteOperator", fields: [operatorUserId], references: [id])

  @@index([familyId, createdAt(sort: Desc)])
  @@index([callType, createdAt(sort: Desc)])
}

enum RelationshipNoteKind {
  fifth_visit
  check_in
  other
}
